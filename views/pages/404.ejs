<%- include('../partials/header') %>

<section class="min-h-[70vh] flex items-center justify-center py-20 bg-grid-pattern bg-radial-gradient text-center">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="glass-card rounded-3xl p-10 sm:p-14 border-slate-800 shadow-2xl reveal">
      
      <div class="text-6xl sm:text-8xl font-extrabold font-['Outfit'] text-transparent bg-clip-text bg-gradient-to-r from-sky-400 via-indigo-400 to-purple-500 mb-4">
        404
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold text-white font-['Outfit'] mb-3">
        <%= typeof customMessage !== 'undefined' ? 'Something Went Wrong' : 'Page Not Found' %>
      </h1>

      <p class="text-slate-400 text-sm leading-relaxed mb-8">
        <%= typeof customMessage !== 'undefined' ? customMessage : "The page you are trying to access does not exist, has been removed, or is temporarily unavailable." %>
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/" class="btn-primary-glow w-full sm:w-auto px-7 py-3.5 rounded-xl font-semibold text-white inline-flex items-center justify-center gap-2">
          <i class="fa-solid fa-house text-xs"></i>
          <span>Return to Homepage</span>
        </a>
        <a href="/contact" class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-medium text-slate-300 bg-slate-900 hover:bg-slate-800 border border-slate-700/80 transition-colors inline-flex items-center justify-center gap-2">
          <i class="fa-solid fa-envelope text-xs"></i>
          <span>Contact Support</span>
        </a>
      </div>

    </div>

  </div>
</section>

<%- include('../partials/footer') %>
