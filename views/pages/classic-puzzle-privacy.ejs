<%- include('../partials/header') %>

<!-- CLASSIC PUZZLE PRIVACY HERO -->
<section class="relative py-16 bg-grid-pattern bg-radial-gradient border-b border-slate-800/80">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    
    <!-- Breadcrumb & Tag -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-6 reveal">
      <a href="/" class="text-xs font-mono text-slate-400 hover:text-sky-400 transition-colors">Home</a>
      <span class="text-xs font-mono text-slate-600">/</span>
      <span class="text-xs font-mono text-slate-400">App Privacy Policies</span>
      <span class="text-xs font-mono text-slate-600">/</span>
      <span class="text-xs font-mono text-sky-400">Classic Puzzle</span>
    </div>

    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/30 text-xs font-mono text-sky-300 mb-6 reveal">
      <i class="fa-solid fa-gamepad text-xs"></i> MOBILE APP PRIVACY POLICY
    </div>

    <h1 class="text-3xl sm:text-5xl font-extrabold font-['Outfit'] text-white tracking-tight mb-4 leading-tight reveal">
      Privacy Policy for <span class="text-gradient">Classic Puzzle</span>
    </h1>

    <p class="text-sm text-slate-400 font-mono reveal">
      Last Updated: August 18, 2026 &bull; Published by <%= company.name %>
    </p>

  </div>
</section>

<!-- QUICK HIGHLIGHT CARDS -->
<section class="py-8 bg-[#07090e] border-b border-slate-800/60">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80 flex items-start gap-3">
        <div class="w-9 h-9 rounded-xl bg-sky-500/10 border border-sky-500/30 flex items-center justify-center text-sky-400 shrink-0">
          <i class="fa-solid fa-user-slash text-sm"></i>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-white font-['Outfit']">No Account Needed</h4>
          <p class="text-xs text-slate-400 mt-0.5">No login, email, or personal info required to play.</p>
        </div>
      </div>

      <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80 flex items-start gap-3">
        <div class="w-9 h-9 rounded-xl bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400 shrink-0">
          <i class="fa-solid fa-hard-drive text-sm"></i>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-white font-['Outfit']">On-Device Storage</h4>
          <p class="text-xs text-slate-400 mt-0.5">Scores & progress remain strictly on your local device.</p>
        </div>
      </div>

      <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80 flex items-start gap-3">
        <div class="w-9 h-9 rounded-xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400 shrink-0">
          <i class="fa-solid fa-lock text-sm"></i>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-white font-['Outfit']">HTTPS Encrypted</h4>
          <p class="text-xs text-slate-400 mt-0.5">All third-party SDK traffic encrypted via TLS.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PRIVACY CONTENT -->
<section class="py-16 bg-[#07090e]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="glass-card rounded-3xl p-8 sm:p-12 border-slate-800 space-y-12 text-slate-300 text-sm sm:text-base leading-relaxed">
      
      <!-- Introduction -->
      <div class="space-y-4">
        <p>
          Thank you for playing <strong class="text-white">Classic Puzzle</strong> ("we", "our", or "us"). We are committed to protecting your privacy. This Privacy Policy explains how our mobile application handles user information, what data may be collected by third-party services, and your rights regarding your information.
        </p>
        <p class="p-4 rounded-xl bg-sky-950/30 border border-sky-500/20 text-sky-200 text-sm">
          <i class="fa-solid fa-circle-info text-sky-400 mr-1.5"></i>
          By downloading, installing, or using Classic Puzzle, you agree to the collection and use of information in accordance with this policy.
        </p>
      </div>

      <!-- 1. Information We Collect -->
      <div class="space-y-6 pt-8 border-t border-slate-800/80">
        <h2 class="text-xl sm:text-2xl font-bold text-white font-['Outfit'] flex items-center gap-3">
          <span class="text-sky-400 font-mono text-base">01.</span> Information We Collect
        </h2>

        <!-- 1.A -->
        <div class="space-y-2.5 bg-slate-900/40 p-5 rounded-2xl border border-slate-800/60">
          <h3 class="text-base font-semibold text-white font-['Outfit'] flex items-center gap-2">
            <span class="w-6 h-6 rounded-md bg-sky-500/20 text-sky-300 flex items-center justify-center text-xs font-mono">A</span>
            Information You Provide
          </h3>
          <p class="text-slate-300 text-sm">
            Classic Puzzle does <strong class="text-white">not</strong> require you to create an account, register, or provide any personally identifiable information (such as your name, email address, physical address, or phone number) to play.
          </p>
        </div>

        <!-- 1.B -->
        <div class="space-y-2.5 bg-slate-900/40 p-5 rounded-2xl border border-slate-800/60">
          <h3 class="text-base font-semibold text-white font-['Outfit'] flex items-center gap-2">
            <span class="w-6 h-6 rounded-md bg-indigo-500/20 text-indigo-300 flex items-center justify-center text-xs font-mono">B</span>
            Information Stored Locally on Your Device
          </h3>
          <p class="text-slate-300 text-sm">
            The app stores gameplay data locally on your device using local storage (<code class="bg-slate-800 text-sky-300 px-1.5 py-0.5 rounded text-xs font-mono">SharedPreferences</code> on Android, <code class="bg-slate-800 text-sky-300 px-1.5 py-0.5 rounded text-xs font-mono">UserDefaults</code> on iOS). This data includes:
          </p>
          <ul class="list-disc list-inside space-y-1.5 pl-2 text-slate-400 text-sm">
            <li>Game progress, completed levels, and stars earned</li>
            <li>Best times and high scores</li>
            <li>In-game preferences (e.g., sound effects, dark mode)</li>
          </ul>
          <p class="text-slate-300 text-xs sm:text-sm font-medium text-emerald-400/90 pt-1">
            <i class="fa-solid fa-shield-check mr-1 text-emerald-400"></i> This information stays entirely on your device and is <strong>never</strong> transmitted to our servers.
          </p>
        </div>

        <!-- 1.C -->
        <div class="space-y-2.5 bg-slate-900/40 p-5 rounded-2xl border border-slate-800/60">
          <h3 class="text-base font-semibold text-white font-['Outfit'] flex items-center gap-2">
            <span class="w-6 h-6 rounded-md bg-purple-500/20 text-purple-300 flex items-center justify-center text-xs font-mono">C</span>
            Automatically Collected Information & Third-Party SDKs
          </h3>
          <p class="text-slate-300 text-sm">
            To provide ads, analytics, and app functionality, we integrate third-party services that may automatically collect certain device and usage data.
          </p>
        </div>
      </div>

      <!-- 2. Third-Party Services & Advertising -->
      <div class="space-y-6 pt-8 border-t border-slate-800/80">
        <h2 class="text-xl sm:text-2xl font-bold text-white font-['Outfit'] flex items-center gap-3">
          <span class="text-sky-400 font-mono text-base">02.</span> Third-Party Services & Advertising
        </h2>
        <p>
          We use <strong class="text-white">Google AdMob</strong> to display advertisements (interstitial and rewarded ads) within the game. AdMob may collect and process certain data in accordance with Google's Privacy Policy.
        </p>

        <!-- Types of Data Collected -->
        <div class="space-y-3">
          <h3 class="text-sm uppercase tracking-wider text-slate-400 font-mono font-semibold">Types of Data Collected by Google AdMob:</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800">
              <div class="text-sky-400 text-xs font-mono font-semibold mb-1"><i class="fa-solid fa-mobile-screen-button mr-1.5"></i> Device Identifiers</div>
              <p class="text-xs text-slate-400">Advertising ID (Google Play Advertising ID / Apple IDFA), unique device identifiers.</p>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800">
              <div class="text-indigo-400 text-xs font-mono font-semibold mb-1"><i class="fa-solid fa-location-dot mr-1.5"></i> Approximate Location</div>
              <p class="text-xs text-slate-400">Country, region, or city inferred from your IP address.</p>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-800">
              <div class="text-purple-400 text-xs font-mono font-semibold mb-1"><i class="fa-solid fa-chart-line mr-1.5"></i> Usage & Interaction</div>
              <p class="text-xs text-slate-400">Ad impressions, clicks, app launch times, and diagnostic logs.</p>
            </div>
          </div>
        </div>

        <!-- Third-Party Links -->
        <div class="space-y-2 pt-2">
          <h3 class="text-sm uppercase tracking-wider text-slate-400 font-mono font-semibold">Third-Party Privacy Policies:</h3>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="https://policies.google.com/technologies/ads" target="_blank" rel="noopener noreferrer" class="p-3 rounded-xl bg-slate-900 hover:bg-slate-800/80 border border-slate-800 hover:border-sky-500/40 transition-colors flex items-center justify-between text-xs text-sky-400 font-mono">
              <span class="flex items-center gap-2"><i class="fa-brands fa-google"></i> Google AdMob & Play Services</span>
              <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
            </a>
            <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="p-3 rounded-xl bg-slate-900 hover:bg-slate-800/80 border border-slate-800 hover:border-sky-500/40 transition-colors flex items-center justify-between text-xs text-sky-400 font-mono">
              <span class="flex items-center gap-2"><i class="fa-solid fa-shield-halved"></i> Google Privacy Policy</span>
              <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- 3. How We Use Collected Information -->
      <div class="space-y-4 pt-8 border-t border-slate-800/80">
        <h2 class="text-xl sm:text-2xl font-bold text-white font-['Outfit'] flex items-center gap-3">
          <span class="text-sky-400 font-mono text-base">03.</span> How We Use Collected Information
        </h2>
        <p>The information collected by third-party advertising partners is used solely for:</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
          <div class="p-3.5 rounded-xl bg-slate-900/50 border border-slate-800/80 flex items-start gap-2.5">
            <i class="fa-solid fa-check text-sky-400 mt-1 text-xs"></i>
            <span class="text-sm text-slate-300">Serving relevant advertisements (personalized or non-personalized)</span>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-900/50 border border-slate-800/80 flex items-start gap-2.5">
            <i class="fa-solid fa-check text-sky-400 mt-1 text-xs"></i>
            <span class="text-sm text-slate-300">Measuring and analyzing ad performance</span>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-900/50 border border-slate-800/80 flex items-start gap-2.5">
            <i class="fa-solid fa-check text-sky-400 mt-1 text-xs"></i>
            <span class="text-sm text-slate-300">Preventing fraud and detecting invalid ad clicks/impressions</span>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-900/50 border border-slate-800/80 flex items-start gap-2.5">
            <i class="fa-solid fa-check text-sky-400 mt-1 text-xs"></i>
            <span class="text-sm text-slate-300">Ensuring app stability and resolving technical issues</span>
          </div>
        </div>
      </div>

      <!-- 4. Children’s Privacy (COPPA) -->
      <div class="space-y-4 pt-8 border-t border-slate-800/80">
        <h2 class="text-xl sm:text-2xl font-bold text-white font-['Outfit'] flex items-center gap-3">
          <span class="text-sky-400 font-mono text-base">04.</span> Children’s Privacy (COPPA Compliance)
        </h2>
        <div class="p-5 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-200/90 text-sm space-y-2">
          <p class="font-medium">
            <i class="fa-solid fa-child-reaching mr-1.5 text-amber-400"></i> Classic Puzzle is intended for a general audience (ages 13 and above). We do not knowingly collect personally identifiable information from children under the age of 13.
          </p>
          <p class="text-slate-300 text-xs sm:text-sm">
            If you are a parent or guardian and believe that your child has provided us with personal information, please contact us so that we can take necessary steps to remove such information.
          </p>
        </div>
      </div>

      <!-- 5. Your Privacy Rights & Ad Choices -->
      <div class="space-y-6 pt-8 border-t border-slate-800/80">
        <h2 class="text-xl sm:text-2xl font-bold text-white font-['Outfit'] flex items-center gap-3">
          <span class="text-sky-400 font-mono text-base">05.</span> Your Privacy Rights & Ad Choices
        </h2>

        <!-- A. Opting Out -->
        <div class="space-y-3 bg-slate-900/40 p-5 rounded-2xl border border-slate-800/60">
          <h3 class="text-base font-semibold text-white font-['Outfit'] flex items-center gap-2">
            <span class="w-6 h-6 rounded-md bg-sky-500/20 text-sky-300 flex items-center justify-center text-xs font-mono">A</span>
            Opting Out of Interest-Based Advertising
          </h3>
          <p class="text-slate-300 text-sm">
            You can manage or reset your advertising identifier and opt out of personalized ads at any time directly through your device settings:
          </p>
          <div class="space-y-2 pt-1 text-xs sm:text-sm">
            <div class="p-3 rounded-xl bg-slate-900/90 border border-slate-800">
              <strong class="text-sky-400"><i class="fa-brands fa-android mr-1"></i> Android:</strong> Open <strong class="text-white">Settings</strong> &rarr; <strong class="text-white">Google</strong> &rarr; <strong class="text-white">Ads</strong> &rarr; Tap <strong class="text-white">Delete advertising ID</strong> or <strong class="text-white">Reset advertising ID</strong>.
            </div>
            <div class="p-3 rounded-xl bg-slate-900/90 border border-slate-800">
              <strong class="text-indigo-400"><i class="fa-brands fa-apple mr-1"></i> iOS:</strong> Open <strong class="text-white">Settings</strong> &rarr; <strong class="text-white">Privacy & Security</strong> &rarr; <strong class="text-white">Tracking</strong> &rarr; Toggle off permissions for the app.
            </div>
          </div>
        </div>

        <!-- B. GDPR -->
        <div class="space-y-2.5 bg-slate-900/40 p-5 rounded-2xl border border-slate-800/60">
          <h3 class="text-base font-semibold text-white font-['Outfit'] flex items-center gap-2">
            <span class="w-6 h-6 rounded-md bg-indigo-500/20 text-indigo-300 flex items-center justify-center text-xs font-mono">B</span>
            GDPR (European Users)
          </h3>
          <p class="text-slate-300 text-sm">If you reside in the European Economic Area (EEA) or the UK:</p>
          <ul class="list-disc list-inside space-y-1 pl-2 text-slate-400 text-sm">
            <li>You have the right to access, rectify, or erase your personal data held by third parties.</li>
            <li>Ad serving is subject to consent mechanisms provided via Google’s Consent Management Platform (CMP).</li>
          </ul>
        </div>

        <!-- C. CCPA / CPRA -->
        <div class="space-y-2.5 bg-slate-900/40 p-5 rounded-2xl border border-slate-800/60">
          <h3 class="text-base font-semibold text-white font-['Outfit'] flex items-center gap-2">
            <span class="w-6 h-6 rounded-md bg-purple-500/20 text-purple-300 flex items-center justify-center text-xs font-mono">C</span>
            CCPA / CPRA (California Residents)
          </h3>
          <p class="text-slate-300 text-sm">
            California residents have the right to know what personal information is collected and to request its deletion. We do not sell personal information.
          </p>
        </div>
      </div>

      <!-- 6. Data Security -->
      <div class="space-y-4 pt-8 border-t border-slate-800/80">
        <h2 class="text-xl sm:text-2xl font-bold text-white font-['Outfit'] flex items-center gap-3">
          <span class="text-sky-400 font-mono text-base">06.</span> Data Security
        </h2>
        <p>
          The security of your data is important to us. All network communications with third-party service providers (such as Google AdMob) are encrypted using standard <strong class="text-white font-mono">HTTPS/TLS</strong> protocols.
        </p>
      </div>

      <!-- 7. Changes to This Privacy Policy -->
      <div class="space-y-4 pt-8 border-t border-slate-800/80">
        <h2 class="text-xl sm:text-2xl font-bold text-white font-['Outfit'] flex items-center gap-3">
          <span class="text-sky-400 font-mono text-base">07.</span> Changes to This Privacy Policy
        </h2>
        <p>
          We may update our Privacy Policy from time to time. Any changes will be posted on this page with an updated "Last Updated" date. You are advised to review this page periodically for any changes.
        </p>
      </div>

      <!-- 8. Contact Us -->
      <div class="space-y-4 pt-8 border-t border-slate-800/80">
        <h2 class="text-xl sm:text-2xl font-bold text-white font-['Outfit'] flex items-center gap-3">
          <span class="text-sky-400 font-mono text-base">08.</span> Contact Us
        </h2>
        <p>
          If you have any questions or suggestions regarding this Privacy Policy, please contact us:
        </p>
        <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-2.5 text-sm">
          <div><strong class="text-white">Developer / Publisher:</strong> Classic Puzzle Team (<%= company.name %>)</div>
          <div><strong class="text-white">Email:</strong> <a href="mailto:<%= company.email %>" class="text-sky-400 underline font-mono"><%= company.email %></a></div>
          <div><strong class="text-white">Website:</strong> <a href="<%= company.url %>" class="text-sky-400 underline font-mono"><%= company.domain %></a></div>
        </div>
      </div>

    </div>
  </div>
</section>

<%- include('../partials/footer') %>
