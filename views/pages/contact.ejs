<%- include('../partials/header') %>

<!-- CONTACT HERO HEADER -->
<section class="relative py-20 bg-grid-pattern bg-radial-gradient border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/30 text-xs font-mono text-sky-300 mb-6 reveal">
      <i class="fa-solid fa-headset text-xs"></i> 24/7 ENGINEERING SUPPORT
    </div>

    <h1 class="text-4xl sm:text-6xl font-extrabold font-['Outfit'] text-white tracking-tight max-w-4xl mx-auto mb-6 leading-tight reveal">
      Let's Build Something <span class="text-gradient">Extraordinary Together</span>
    </h1>

    <p class="text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed reveal">
      Have a question, a new product idea, or need an enterprise quote? Fill out the form below or write directly to <a href="mailto:<%= company.email %>" class="text-sky-400 font-mono underline"><%= company.email %></a>.
    </p>

  </div>
</section>

<!-- CONTACT SECTION -->
<section class="py-20 bg-[#07090e]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Left Column: Contact Info & Details (5 cols) -->
      <div class="lg:col-span-5 space-y-8 reveal">
        
        <div>
          <div class="text-xs uppercase font-mono tracking-widest text-sky-400 font-semibold mb-2">DIRECT CHANNELS</div>
          <h2 class="text-2xl sm:text-3xl font-bold font-['Outfit'] text-white">Get in Touch</h2>
          <p class="text-slate-400 text-sm mt-2 leading-relaxed">
            Our engineering and solution design team is ready to discuss technical architecture, milestones, and estimates.
          </p>
        </div>

        <!-- Info Cards -->
        <div class="space-y-4">
          
          <!-- Email -->
          <div class="glass-card rounded-2xl p-5 flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-sky-500/10 border border-sky-500/30 flex items-center justify-center text-sky-400 text-xl shrink-0">
              <i class="fa-solid fa-envelope"></i>
            </div>
            <div>
              <div class="text-xs font-mono text-slate-500 uppercase tracking-wider">Official Email</div>
              <a href="mailto:<%= company.email %>" class="text-base font-semibold text-white hover:text-sky-400 transition-colors font-mono">
                <%= company.email %>
              </a>
              <p class="text-xs text-slate-400 mt-0.5">Average response time: &lt; 4 hours</p>
            </div>
          </div>

          <!-- Phone -->
          <div class="glass-card rounded-2xl p-5 flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400 text-xl shrink-0">
              <i class="fa-solid fa-phone"></i>
            </div>
            <div>
              <div class="text-xs font-mono text-slate-500 uppercase tracking-wider">Call / WhatsApp</div>
              <a href="tel:<%= company.phone.replace(/[^0-9+]/g, '') %>" class="text-base font-semibold text-white hover:text-indigo-400 transition-colors font-mono">
                <%= company.phone %>
              </a>
              <p class="text-xs text-slate-400 mt-0.5">Mon - Sat: 9:00 AM - 7:00 PM IST</p>
            </div>
          </div>

          <!-- Location -->
          <div class="glass-card rounded-2xl p-5 flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400 text-xl shrink-0">
              <i class="fa-solid fa-location-dot"></i>
            </div>
            <div>
              <div class="text-xs font-mono text-slate-500 uppercase tracking-wider">Headquarters</div>
              <div class="text-base font-semibold text-white">
                <%= company.address %>
              </div>
              <p class="text-xs text-slate-400 mt-0.5">Global Remote & Hybrid Services</p>
            </div>
          </div>

        </div>

        <!-- Styled Map Card -->
        <div class="glass-card rounded-2xl p-5 overflow-hidden">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-mono text-slate-400 flex items-center gap-2">
              <i class="fa-solid fa-map-pin text-sky-400"></i> Global Service Coverage
            </span>
            <span class="text-[10px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
              Worldwide Delivery
            </span>
          </div>
          <div class="w-full h-44 rounded-xl overflow-hidden bg-slate-900 border border-slate-800 relative">
            <iframe 
              title="Office Location Map"
              class="w-full h-full border-0 grayscale opacity-75 hover:opacity-100 hover:grayscale-0 transition-all duration-300"
              src="https://maps.google.com/maps?q=Guwahati,%20Assam&t=&z=12&ie=UTF8&iwloc=&output=embed"
              loading="lazy">
            </iframe>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Form (7 cols) -->
      <div class="lg:col-span-7 reveal">
        <div class="glass-card rounded-3xl p-8 sm:p-10 border-slate-700/60 shadow-2xl relative">
          
          <div class="border-b border-slate-800 pb-6 mb-8">
            <h3 class="text-2xl font-bold font-['Outfit'] text-white">Send Us a Project Inquiry</h3>
            <p class="text-xs sm:text-sm text-slate-400 mt-1">
              Fill out your requirements and we will review and reply with a tailored action plan.
            </p>
          </div>

          <!-- Alert Container for Dynamic AJAX feedback -->
          <div id="formAlert" class="<%= (typeof submitted !== 'undefined' && submitted) ? '' : 'hidden' %> p-4 rounded-xl mb-6 text-sm font-medium bg-emerald-950/80 border border-emerald-500/40 text-emerald-300">
            <div class="flex items-start gap-3">
              <i class="fa-solid fa-circle-check text-emerald-400 text-lg mt-0.5"></i>
              <div>
                <div class="font-semibold">Thank you for reaching out!</div>
                <div class="text-xs opacity-90 mt-1">Your inquiry has been received. Our team will contact you shortly.</div>
              </div>
            </div>
          </div>

          <!-- Contact Form -->
          <form id="contactForm" action="/api/contact" method="POST" class="space-y-6">
            
            <!-- Name & Email row -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              
              <div>
                <label for="name" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                  Your Full Name <span class="text-rose-400">*</span>
                </label>
                <div class="relative">
                  <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                    <i class="fa-regular fa-user text-sm"></i>
                  </span>
                  <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    required 
                    placeholder="e.g. Alex Henderson"
                    value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>"
                    class="w-full pl-10 pr-4 py-3 bg-slate-900/90 border border-slate-700/80 focus:border-sky-400 focus:ring-1 focus:ring-sky-400 rounded-xl text-sm text-white placeholder-slate-500 outline-none transition-colors"
                  >
                </div>
              </div>

              <div>
                <label for="email" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                  Email Address <span class="text-rose-400">*</span>
                </label>
                <div class="relative">
                  <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                    <i class="fa-regular fa-envelope text-sm"></i>
                  </span>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    required 
                    placeholder="alex@company.com"
                    value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
                    class="w-full pl-10 pr-4 py-3 bg-slate-900/90 border border-slate-700/80 focus:border-sky-400 focus:ring-1 focus:ring-sky-400 rounded-xl text-sm text-white placeholder-slate-500 outline-none transition-colors"
                  >
                </div>
              </div>

            </div>

            <!-- Phone & Subject row -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              
              <div>
                <label for="phone" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                  Phone / WhatsApp <span class="text-slate-500 font-normal">(Optional)</span>
                </label>
                <div class="relative">
                  <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                    <i class="fa-solid fa-phone text-sm"></i>
                  </span>
                  <input 
                    type="tel" 
                    id="phone" 
                    name="phone" 
                    placeholder="+1 (555) 000-0000"
                    value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>"
                    class="w-full pl-10 pr-4 py-3 bg-slate-900/90 border border-slate-700/80 focus:border-sky-400 focus:ring-1 focus:ring-sky-400 rounded-xl text-sm text-white placeholder-slate-500 outline-none transition-colors"
                  >
                </div>
              </div>

              <div>
                <label for="subject" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                  Service of Interest <span class="text-rose-400">*</span>
                </label>
                <div class="relative">
                  <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                    <i class="fa-solid fa-layer-group text-sm"></i>
                  </span>
                  <select 
                    id="subject" 
                    name="subject" 
                    required
                    class="w-full pl-10 pr-8 py-3 bg-slate-900/90 border border-slate-700/80 focus:border-sky-400 focus:ring-1 focus:ring-sky-400 rounded-xl text-sm text-white outline-none transition-colors appearance-none cursor-pointer"
                  >
                    <option value="Website Development">Website Development</option>
                    <option value="SaaS App Development">SaaS Cloud App Development</option>
                    <option value="Android / iOS Mobile App">Android / iOS Mobile App</option>
                    <option value="Custom Software Architecture">Custom Software Architecture</option>
                    <option value="General Technical Consultation">General Technical Consultation</option>
                  </select>
                  <span class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-500">
                    <i class="fa-solid fa-chevron-down text-xs"></i>
                  </span>
                </div>
              </div>

            </div>

            <!-- Message details -->
            <div>
              <label for="message" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
                Project Scope & Details <span class="text-rose-400">*</span>
              </label>
              <textarea 
                id="message" 
                name="message" 
                rows="5" 
                required 
                placeholder="Tell us about your project requirements, target platform, timeline, or any specific technologies you'd like to use..."
                class="w-full p-4 bg-slate-900/90 border border-slate-700/80 focus:border-sky-400 focus:ring-1 focus:ring-sky-400 rounded-xl text-sm text-white placeholder-slate-500 outline-none transition-colors resize-none"
              ><%= typeof formData !== 'undefined' && formData.message ? formData.message : '' %></textarea>
            </div>

            <!-- Submit Button -->
            <button 
              type="submit" 
              id="submitBtn"
              class="btn-primary-glow w-full py-4 rounded-xl text-base font-semibold text-white shadow-xl shadow-sky-500/25 flex items-center justify-center gap-3 transition-all cursor-pointer"
            >
              <span>Submit Project Inquiry</span>
              <i class="fa-solid fa-paper-plane text-sm"></i>
            </button>

            <p class="text-[11px] text-center text-slate-400">
              🔒 We value your privacy. Your information is protected under our <a href="/privacy-policy" class="text-sky-400 underline">Privacy Policy</a>.
            </p>

          </form>

        </div>
      </div>

    </div>

  </div>
</section>

<!-- Include Contact Form AJAX Script -->
<script src="/js/contact-form.js"></script>

<%- include('../partials/footer') %>
