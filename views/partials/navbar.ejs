<header id="main-navbar" class="fixed top-0 left-0 right-0 z-50 glass-nav border-b border-slate-800/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-slate-900/90 border border-amber-500/30 p-1 flex items-center justify-center transition-all duration-300 group-hover:scale-105 group-hover:border-amber-400/60 shadow-lg shadow-amber-500/10">
          <img src="/assets/logo.png" alt="Oxomsoft Software Solution" class="w-full h-full object-contain" width="40" height="40">
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-bold tracking-tight text-white font-['Outfit']">
            Oxom<span class="text-sky-400">soft</span>
          </span>
          <span class="text-[10px] tracking-widest text-slate-400 uppercase font-medium -mt-1">
            Software Solution
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
        <a href="/" class="px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200 <%= currentPath === '/' ? 'text-sky-400 bg-sky-500/10 border border-sky-500/20' : 'text-slate-300 hover:text-white hover:bg-slate-800/50' %>">
          Home
        </a>
        <a href="/about" class="px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200 <%= currentPath === '/about' ? 'text-sky-400 bg-sky-500/10 border border-sky-500/20' : 'text-slate-300 hover:text-white hover:bg-slate-800/50' %>">
          About Us
        </a>
        <a href="/#services" class="px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200 text-slate-300 hover:text-white hover:bg-slate-800/50">
          Services
        </a>
        <a href="/#process" class="px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200 text-slate-300 hover:text-white hover:bg-slate-800/50">
          Process
        </a>
        <a href="/contact" class="px-4 py-2 text-sm font-medium rounded-lg transition-all duration-200 <%= currentPath === '/contact' ? 'text-sky-400 bg-sky-500/10 border border-sky-500/20' : 'text-slate-300 hover:text-white hover:bg-slate-800/50' %>">
          Contact
        </a>
      </nav>

      <!-- CTA Button & Contact Quick Link -->
      <div class="hidden md:flex items-center gap-4">
        <a href="mailto:<%= company.email %>" class="text-xs text-slate-400 hover:text-sky-400 transition-colors hidden xl:flex items-center gap-1.5 font-mono">
          <i class="fa-regular fa-envelope text-sky-400"></i>
          <%= company.email %>
        </a>
        <a href="/contact" class="btn-primary-glow px-5 py-2.5 rounded-xl text-sm font-semibold text-white shadow-lg shadow-sky-500/20 flex items-center gap-2">
          <span>Start a Project</span>
          <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex md:hidden">
        <button id="mobile-menu-btn" type="button" class="p-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800/60 focus:outline-none transition-colors" aria-label="Toggle navigation menu">
          <i id="menu-open-icon" class="fa-solid fa-bars text-xl"></i>
          <i id="menu-close-icon" class="fa-solid fa-xmark text-xl hidden"></i>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-slate-950/95 backdrop-blur-2xl border-b border-slate-800 px-4 pt-3 pb-6 space-y-2">
    <a href="/" class="block px-4 py-3 rounded-xl text-base font-medium <%= currentPath === '/' ? 'text-sky-400 bg-sky-500/10 font-semibold' : 'text-slate-200 hover:bg-slate-900' %>">
      <i class="fa-solid fa-house w-6 text-sky-400 text-sm"></i> Home
    </a>
    <a href="/about" class="block px-4 py-3 rounded-xl text-base font-medium <%= currentPath === '/about' ? 'text-sky-400 bg-sky-500/10 font-semibold' : 'text-slate-200 hover:bg-slate-900' %>">
      <i class="fa-solid fa-building w-6 text-indigo-400 text-sm"></i> About Us
    </a>
    <a href="/#services" class="block px-4 py-3 rounded-xl text-base font-medium text-slate-200 hover:bg-slate-900">
      <i class="fa-solid fa-cubes w-6 text-purple-400 text-sm"></i> Services
    </a>
    <a href="/#process" class="block px-4 py-3 rounded-xl text-base font-medium text-slate-200 hover:bg-slate-900">
      <i class="fa-solid fa-diagram-project w-6 text-teal-400 text-sm"></i> Process
    </a>
    <a href="/contact" class="block px-4 py-3 rounded-xl text-base font-medium <%= currentPath === '/contact' ? 'text-sky-400 bg-sky-500/10 font-semibold' : 'text-slate-200 hover:bg-slate-900' %>">
      <i class="fa-solid fa-envelope w-6 text-rose-400 text-sm"></i> Contact Us
    </a>
    <a href="/privacy-policy" class="block px-4 py-3 rounded-xl text-sm font-medium text-slate-400 hover:bg-slate-900">
      <i class="fa-solid fa-shield-halved w-6 text-slate-500 text-sm"></i> Privacy Policy
    </a>

    <div class="pt-4 mt-4 border-t border-slate-800/80">
      <a href="/contact" class="btn-primary-glow w-full py-3 rounded-xl text-center font-semibold text-white block">
        Get Started Now
      </a>
      <p class="text-xs text-center text-slate-500 mt-3 font-mono">
        <%= company.email %>
      </p>
    </div>
  </div>
</header>
