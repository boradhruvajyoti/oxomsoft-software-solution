# Application Configuration
NODE_ENV=production
PORT=3000
APP_NAME="Oxomsoft Software Solution"
APP_DOMAIN=oxomsoft.in
APP_URL=https://oxomsoft.in

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=oxomsoft_user
DB_PASSWORD=your_secure_db_password
DB_NAME=oxomsoft_db
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# Email Notification Configuration (Nodemailer SMTP - Optional)
# Configure if you want contact form submissions emailed to support@oxomsoft.com
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@oxomsoft.in
SMTP_PASS=your_smtp_password
MAIL_FROM="Oxomsoft Web Form <no-reply@oxomsoft.in>"
SUPPORT_EMAIL=support@oxomsoft.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100           # 100 requests per IP per window
CONTACT_RATE_LIMIT_MAX=5    # 5 contact submissions per 15 min per IP
